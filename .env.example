# ─────────────────────────────────────────────────────────────────────────────
# MediChain Backend — Environment Variables
# Copy this file to .env and fill in all values before running
# NEVER commit .env to git
# ─────────────────────────────────────────────────────────────────────────────

# ── App ─────────────────────────────────────────────────────────────────────
APP_ENV=production
SECRET_KEY=replace-with-a-strong-random-secret

# Comma-separated list of allowed CORS origins
# In production, replace * with your actual frontend domain
ALLOWED_ORIGINS=["*"]

# ── InsightFace ──────────────────────────────────────────────────────────────
# buffalo_l  = ArcFace R100 (best accuracy, default)
# buffalo_sc = ArcFace R50  (faster, slightly lower accuracy)
INSIGHTFACE_MODEL=buffalo_l
INSIGHTFACE_DET_SIZE=640

# Cosine distance threshold for a valid match (0.0 = strict, 1.0 = loose)
# 0.45 means similarity must be ≥ 0.55 (55%)
# Recommended: 0.45 for medical use (conservative — fewer false positives)
FACE_MATCH_THRESHOLD=0.45

# ── Firebase ─────────────────────────────────────────────────────────────────
# Path to your Firebase service account JSON key
# Download from: Firebase Console → Project Settings → Service Accounts
# On Render: upload as a secret file and set this path
FIREBASE_CREDENTIALS_PATH=firebase_credentials.json
FIRESTORE_PATIENTS_COLLECTION=patients

# ── LLM Gateway (Gemini primary + Groq fallback) ───────────────────────────
# Gemini API Key: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini/gemini-1.5-flash
GEMINI_PRO_MODEL=gemini/gemini-1.5-pro

# Groq API Key: https://console.groq.com/ (fallback)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile
LLM_FALLBACK_MODEL=groq/llama-3.3-70b-versatile

# ── LangSmith Tracing & Observability ────────────────────────────────────────
# LangSmith API Key: https://smith.langchain.com/
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT=medichain
LANGSMITH_TRACING=true

# ── Doctor Audit ─────────────────────────────────────────────────────────────
DOCTOR_QUERIES_COLLECTION=doctor_queries
