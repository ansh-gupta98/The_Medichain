# ─────────────────────────────────────────────────────────────────────────────
# MediChain — Complete Environment Variables (Local & Railway Production)
# ─────────────────────────────────────────────────────────────────────────────

# ── App & Server ─────────────────────────────────────────────────────────────
APP_ENV=production
SECRET_KEY=replace-with-a-strong-random-secret
ALLOWED_ORIGINS=["*"]
MEDICHAIN_HOST=0.0.0.0
MEDICHAIN_QR_SECRET=medichain-qr-secret-key

# ── InsightFace (buffalo_l ArcFace R100) ────────────────────────────────────
INSIGHTFACE_MODEL=buffalo_l
INSIGHTFACE_DET_SIZE=640
INSIGHTFACE_HOME=/root/.insightface
FACE_MATCH_THRESHOLD=0.45

# ── Firebase Firestore ───────────────────────────────────────────────────────
# Local dev uses file path; Railway production uses FIREBASE_CREDENTIALS_JSON string
FIREBASE_CREDENTIALS_PATH=firebase_credentials.json
FIREBASE_CREDENTIALS_JSON=
FIRESTORE_PATIENTS_COLLECTION=patients

# ── Groq AI (Vision OCR & Fallback) ──────────────────────────────────────────
# Groq Key: https://console.groq.com/
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview

# ── LLM Gateway (Gemini Primary + Groq Fallback) ─────────────────────────────
# Gemini Key: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini/gemini-1.5-flash
GEMINI_PRO_MODEL=gemini/gemini-1.5-pro
LLM_FALLBACK_MODEL=groq/llama-3.3-70b-versatile

# ── LangChain & LangSmith Observability ──────────────────────────────────────
# LangChain Key: https://smith.langchain.com/ (Settings -> API Keys)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langchain-api-key-here
LANGCHAIN_PROJECT=medichain
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ── Doctor Audit ─────────────────────────────────────────────────────────────
DOCTOR_QUERIES_COLLECTION=doctor_queries
